+find_dependency(ICU COMPONENTS ${_libphonenumber_icu_components})
+unset(_libphonenumber_icu_components)
+
+if (@USE_BOOST@)
+  find_dependency(Boost CONFIG COMPONENTS date_time system thread)
+endif ()
+
+if (@USE_RE2@)
+  find_dependency(re2 CONFIG)
+endif ()
 
