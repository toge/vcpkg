-find_dependency(absl)
-find_dependency(Protobuf)
+find_dependency(absl CONFIG)
+find_dependency(Protobuf CONFIG)
+
+set(_libphonenumber_icu_components uc)
+if (@USE_ICU_REGEXP@ OR @BUILD_GEOCODER@)
+  list(APPEND _libphonenumber_icu_components i18n)
